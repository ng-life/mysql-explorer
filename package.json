{
  "name": "mysql-explorer-web",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm build:editor && pnpm build:grid",
    "build:editor": "esbuild frontend/editor.js --bundle --minify --format=iife --target=es2020 --legal-comments=linked --outfile=internal/web/assets/editor.js",
    "build:grid": "esbuild frontend/result-grid.js --bundle --minify --format=iife --target=es2020 --legal-comments=linked --outfile=internal/web/assets/result-grid.js && cp node_modules/tabulator-tables/LICENSE internal/web/assets/result-grid.LICENSE.txt"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-sql": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "sql-formatter": "^15.9.0",
    "tabulator-tables": "6.7.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
